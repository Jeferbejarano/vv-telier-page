---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Carrito from '../components/Carrito.astro';
import Footer from '../components/Footer.astro';
import { productos } from '../data/productos.js';
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VV TELIER | Bolsos Transparentes & Cuero</title>
</head>
<body class="bg-white text-[#181818] antialiased">

  <Navbar />
  <Hero />

  <main id="catalogo" class="max-w-7xl mx-auto py-14 px-[5%]">
    <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
      <h2 class="font-serif text-2xl md:text-3xl font-normal tracking-wide">Catálogo de Productos</h2>
      <select onchange="ordenarProductos(this.value)" class="px-3 py-2 border border-[#e5e0d8] bg-white text-sm text-[#181818]">
        <option value="default">Orden predeterminado</option>
        <option value="asc">Precio: menor a mayor</option>
        <option value="desc">Precio: mayor a menor</option>
      </select>
    </div>

    <div id="grid-productos" class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8"></div>
  </main>
<!-- Sección: Propuesta de Valor (3 Pilares) -->
<section class="bg-[#faf8f5] border-t border-b border-[#e5e0d8] py-16 px-6">
  <div class="max-w-6xl mx-auto">
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-[11px] font-bold uppercase tracking-[0.2em] text-[#7c4d2b]">
        ¿Por qué elegir Valvera Telier?
      </span>
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-[#181818] mt-2">
        Diseño urbano pensado para acompañarte todos los días
      </h2>
    </div>

    <!-- Cuadrícula de 3 pilares -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Pilar 1 -->
      <div class="bg-white p-8 rounded-xl border border-[#e5e0d8] shadow-xs hover:border-[#7c4d2b] transition duration-300">
        <div class="w-10 h-10 rounded-full bg-[#faf8f5] border border-[#e5e0d8] flex items-center justify-center text-sm font-bold text-[#7c4d2b] mb-5">
          01
        </div>
        <h3 class="font-serif text-xl font-bold text-[#181818] mb-3">
          Materiales Nacionales Resistentes
        </h3>
        <p class="text-sm text-[#555555] leading-relaxed">
          Confección cuidada con insumos colombianos de alto calibre, para aguantar tu ritmo diario sin deformarse.
        </p>
      </div>

      <!-- Pilar 2 -->
      <div class="bg-white p-8 rounded-xl border border-[#e5e0d8] shadow-xs hover:border-[#7c4d2b] transition duration-300">
        <div class="w-10 h-10 rounded-full bg-[#faf8f5] border border-[#e5e0d8] flex items-center justify-center text-sm font-bold text-[#7c4d2b] mb-5">
          02
        </div>
        <h3 class="font-serif text-xl font-bold text-[#181818] mb-3">
          Diseño 100% Personalizable
        </h3>
        <p class="text-sm text-[#555555] leading-relaxed">
          No vendemos en serie sin alma: elige combinaciones, acabados y detalles únicos para que tu bolso o morral refleje tu verdadera autenticidad.
        </p>
      </div>

      <!-- Pilar 3 -->
      <div class="bg-white p-8 rounded-xl border border-[#e5e0d8] shadow-xs hover:border-[#7c4d2b] transition duration-300">
        <div class="w-10 h-10 rounded-full bg-[#faf8f5] border border-[#e5e0d8] flex items-center justify-center text-sm font-bold text-[#7c4d2b] mb-5">
          03
        </div>
        <h3 class="font-serif text-xl font-bold text-[#181818] mb-3">
          Compra Directa y Segura
        </h3>
        <p class="text-sm text-[#555555] leading-relaxed">
          Arma tu carrito en segundos y finaliza tu pedido directo por WhatsApp con asesoría personalizada y envíos seguros a todo el país.
        </p>
      </div>
    </div>
  </div>
</section>

  <Footer />
  <Carrito />

  <script is:inline define:vars={{ productos }}>
    let carrito = JSON.parse(localStorage.getItem("vvtelier_carrito")) || [];
    let categoriaActual = "Todos";
    let ordenActual = "default";

    function renderizarCatalogo() {
      const contenedor = document.getElementById("grid-productos");
      if (!contenedor) return;

      let lista = categoriaActual === "Todos"
        ? [...productos]
        : productos.filter(p => p.categoria.toLowerCase() === categoriaActual.toLowerCase());

      if (ordenActual === "asc") lista.sort((a, b) => a.precio - b.precio);
      if (ordenActual === "desc") lista.sort((a, b) => b.precio - a.precio);

      contenedor.innerHTML = lista.map(item => `
        <article class="bg-white border border-[#e5e0d8] rounded-sm overflow-hidden flex flex-col justify-between relative hover:-translate-y-1 hover:shadow-lg transition duration-300">
          ${item.agotado ? '<span class="absolute top-3 left-3 bg-[#181818] text-white text-xs px-2.5 py-1 z-10">Agotado</span>' : ''}
          <img src="${item.img}" alt="${item.nombre}" onclick="abrirVistaRapida(${item.id})" class="w-full h-52 md:h-76 object-contain p-4 bg-white cursor-pointer hover:scale-105 transition duration-500" />
          <div class="p-4 md:p-5 text-center bg-white z-10">
            <div class="text-xs text-[#6e6a66] uppercase">${item.categoria}</div>
            <h3 class="text-sm md:text-base font-medium my-1.5">${item.nombre}</h3>
            <div class="text-base font-bold text-[#7c4d2b] mb-4">$ ${item.precio.toLocaleString('es-CO')}</div>
            <div class="flex flex-col gap-2">
              <button ${item.agotado ? 'disabled' : `onclick="agregarAlCarrito(${item.id})"`} class="w-full py-2.5 px-3 text-xs font-semibold tracking-wider uppercase transition cursor-pointer ${item.agotado ? 'border border-gray-300 text-gray-400 cursor-not-allowed' : 'bg-[#181818] hover:bg-[#7c4d2b] text-white'}">
                ${item.agotado ? 'Agotado' : 'Añadir al carrito'}
              </button>
              <button onclick="abrirVistaRapida(${item.id})" class="w-full py-2 border border-[#e5e0d8] hover:border-[#7c4d2b] text-xs text-[#6e6a66] transition cursor-pointer">
                👁 Vista rápida
              </button>
            </div>
          </div>
        </article>
      `).join('');
    }

    window.filtrarCategoria = (cat) => { categoriaActual = cat; renderizarCatalogo(); };
    window.ordenarProductos = (ord) => { ordenActual = ord; renderizarCatalogo(); };

    window.abrirVistaRapida = (id) => {
    const prod = productos.find(p => p.id === id);
   if (!prod) return;
   document.getElementById("modal-vista-rapida")?.remove();

   // Usa la galería completa o, si solo tiene 1 foto, usa la imagen principal
   const fotos = (prod.galeria && prod.galeria.length > 0) ? prod.galeria : [prod.img];

   const miniaturasHTML = fotos.map((fotoUrl, index) => `
    <img 
      src="${fotoUrl}" 
      alt="Ángulo ${index + 1}" 
      onclick="cambiarFotoModal('${fotoUrl}', this)"
      class="miniatura-modal w-14 h-14 object-contain border-2 ${index === 0 ? 'border-[#7c4d2b]' : 'border-[#e5e0d8]'} p-1 rounded-sm cursor-pointer hover:border-[#7c4d2b] transition bg-white"
    />
   `).join('');

   const modalHTML = `
    <div id="modal-vista-rapida" onclick="if(event.target === this) this.remove()" class="fixed inset-0 bg-black/65 z-50 flex items-center justify-center p-4">
      <div class="bg-white max-w-3xl w-full rounded-sm overflow-hidden grid grid-cols-1 md:grid-cols-2 relative shadow-2xl max-h-[92vh] overflow-y-auto">
        
        <button onclick="document.getElementById('modal-vista-rapida').remove()" class="absolute top-3 right-4 text-2xl text-[#181818] hover:text-[#7c4d2b] cursor-pointer z-10">✕</button>
        
        <!-- Columna izquierda: Foto grande + 6 miniaturas de ángulos -->
        <div class="p-6 flex flex-col items-center justify-center bg-[#faf9f7] border-b md:border-b-0 md:border-r border-[#e5e0d8]">
          <div class="w-full h-64 md:h-80 flex items-center justify-center bg-white rounded-sm p-3 mb-4 border border-[#e5e0d8]">
            <img id="imagen-principal-modal" src="${fotos[0]}" alt="${prod.nombre}" class="max-h-full max-w-full object-contain transition duration-300" />
          </div>
          
          <!-- Tira de miniaturas para cambiar de ángulo -->
          <div class="flex flex-wrap justify-center gap-2">
            ${miniaturasHTML}
          </div>
        </div>

        <!-- Columna derecha: Información exclusiva del producto -->
        <div class="p-6 md:p-8 flex flex-col justify-center">
          <small class="text-xs text-[#6e6a66] tracking-widest uppercase">${prod.categoria}</small>
          <h2 class="font-serif text-2xl md:text-3xl my-2 text-[#181818]">${prod.nombre}</h2>
          <p class="text-2xl font-bold text-[#7c4d2b] mb-4">$ ${prod.precio.toLocaleString('es-CO')}</p>
          <p class="text-sm text-gray-700 leading-relaxed mb-4">${prod.descripcion}</p>
          
          <div class="bg-[#f8f6f3] p-3 rounded-sm border border-[#e5e0d8] mb-6">
            <p class="text-xs text-[#2b2623]"><strong>📏 Medidas exactas:</strong> ${prod.medidas}</p>
          </div>

          <button ${prod.agotado ? 'disabled' : `onclick="agregarAlCarrito(${prod.id}); document.getElementById('modal-vista-rapida').remove();"`} class="w-full py-3.5 bg-[#181818] hover:bg-[#7c4d2b] text-white text-xs font-semibold uppercase tracking-widest transition cursor-pointer">
            ${prod.agotado ? 'Agotado' : 'Añadir al carrito'}
          </button>
        </div>

      </div>
    </div>
  `;
  document.body.insertAdjacentHTML("beforeend", modalHTML);
};

// Función auxiliar para cambiar la foto grande al tocar una miniatura
window.cambiarFotoModal = (nuevaUrl, elementoSeleccionado) => {
  const imgPrincipal = document.getElementById("imagen-principal-modal");
  if (imgPrincipal) imgPrincipal.src = nuevaUrl;

  document.querySelectorAll(".miniatura-modal").forEach(img => {
    img.classList.remove("border-[#7c4d2b]");
    img.classList.add("border-[#e5e0d8]");
  });
  elementoSeleccionado.classList.remove("border-[#e5e0d8]");
  elementoSeleccionado.classList.add("border-[#7c4d2b]");
};

    window.toggleCarrito = () => {
      const drawer = document.getElementById("cart-drawer");
      const overlay = document.getElementById("cart-overlay");
      drawer.classList.toggle("-right-full");
      drawer.classList.toggle("right-0");
      overlay.classList.toggle("hidden");
    };

    window.agregarAlCarrito = (id) => {
      const producto = productos.find(p => p.id === id);
      if (!producto || producto.agotado) return;
      const existente = carrito.find(item => item.id === id);
      existente ? existente.cantidad++ : carrito.push({ ...producto, cantidad: 1 });
      localStorage.setItem("vvtelier_carrito", JSON.stringify(carrito));
      actualizarVistaCarrito();
      if (document.getElementById("cart-drawer").classList.contains("-right-full")) toggleCarrito();
    };

    window.cambiarCantidad = (id, delta) => {
      const item = carrito.find(p => p.id === id);
      if (!item) return;
      item.cantidad += delta;
      if (item.cantidad <= 0) carrito = carrito.filter(p => p.id !== id);
      localStorage.setItem("vvtelier_carrito", JSON.stringify(carrito));
      actualizarVistaCarrito();
    };

    function actualizarVistaCarrito() {
      const totalItems = carrito.reduce((acc, item) => acc + item.cantidad, 0);
      const totalPrecio = carrito.reduce((acc, item) => acc + (item.precio * item.cantidad), 0);
      document.getElementById("cart-count").innerText = totalItems;
      document.getElementById("cart-total-price").innerText = `$ ${totalPrecio.toLocaleString('es-CO')}`;

      const container = document.getElementById("cart-items-container");
      if (carrito.length === 0) {
        container.innerHTML = '<p class="text-[#6e6a66] text-center mt-10">Tu carrito está vacío.</p>';
        return;
      }

      container.innerHTML = carrito.map(item => `
        <div class="flex justify-between items-center pb-3.5 mb-3.5 border-b border-[#e5e0d8] gap-2.5">
          <div>
            <h4 class="text-sm font-medium mb-1">${item.nombre}</h4>
            <span class="text-sm text-[#7c4d2b] font-semibold">$ ${(item.precio * item.cantidad).toLocaleString('es-CO')}</span>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="cambiarCantidad(${item.id}, -1)" class="w-7 h-7 border border-[#e5e0d8] font-bold cursor-pointer">-</button>
            <span class="text-sm">${item.cantidad}</span>
            <button onclick="cambiarCantidad(${item.id}, 1)" class="w-7 h-7 border border-[#e5e0d8] font-bold cursor-pointer">+</button>
          </div>
        </div>
      `).join('');
    }

    window.enviarPedidoWhatsApp = () => {
      if (carrito.length === 0) return alert("Agrega al menos un bolso al carrito.");
      let mensaje = "Hola VV TELIER, quiero realizar el siguiente pedido:\n\n";
      carrito.forEach(item => {
        mensaje += `• ${item.cantidad}x ${item.nombre} - $${(item.precio * item.cantidad).toLocaleString('es-CO')}\n`;
      });
      const total = carrito.reduce((acc, item) => acc + (item.precio * item.cantidad), 0);
      mensaje += `\n*Total a pagar: $${total.toLocaleString('es-CO')}*`;
      window.open(`https://whatsapp.com{encodeURIComponent(mensaje)}`, "_blank", "noopener,noreferrer");
    };

    renderizarCatalogo();
    actualizarVistaCarrito();
  </script>
</body>
</html>
